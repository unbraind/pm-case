  PM_TEST_DEPTH=quick npm run coverage,project,1200,codex-sol,"2026-11-15T14:23:39.328Z",local_mutation,ci/quick-pr-tier-deep-local-tier
  "npm run typecheck && npm run lint --if-present && npm run build && npm run build:test && PM_TEST_DEPTH=quick node --test --test-concurrency=2 test/workflow.test.ts test/release-workflow.test.ts test/install-tools.test.ts && node --input-type=module -e 'import {readFileSync,readdirSync} from \"node:fs\"; import {parseDocument} from \"yaml\"; for(const file of readdirSync(\".github/workflows\").filter(f=>/\\.ya?ml$/.test(f))){ const d=parseDocument(readFileSync(\".github/workflows/\"+file,\"utf8\"),{uniqueKeys:true}); if(d.errors.length) throw new Error(file+\": \"+d.errors.join(\";\")); } console.log(\"Strict workflow YAML passed\");'",project,900,codex-sol,"2026-11-15T18:56:10.075Z",local_mutation,ci/quick-pr-tier-deep-local-tier
